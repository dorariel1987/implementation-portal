# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://portal:portal@localhost:5544/implementation_portal?schema=public"

# JWT signing key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="please-change-me-to-a-long-random-string-at-least-32-chars"

# Session lifetime (applies to both browser cookies and Bearer tokens issued
# via /api/v1/auth/login).
SESSION_MAX_AGE_HOURS=12
